megs: 128
romimage: file=/usr/share/bochs/BIOS-bochs-legacy, address=0xffff0000
vgaromimage: file=/usr/share/bochs/VGABIOS-lgpl-latest
#floppya: 1_44=dos5/Dos5.0.img, status=inserted
#floppya: 1_44=build/disk.img, status=inserted
#boot: floppy





# Master drive setup on the primary ATA channel (IDE controller)
# Replace "c.img" with the absolute or relative path to your actual image
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=disk, path="build/disk.img", mode=flat

# The crucial instruction to change the boot prioritization order
boot: disk


mouse: enabled=0
display_library: x, options="gui_debug"
